---
import Layout from '../layouts/Layout.astro';
import Paper from '../components/Paper.astro';
import { profile, news } from '../data/profile';
import { selected } from '../data/publications';
import { path } from '../lib/paths';

// Keep the complete source list. ISO dates determine display order, regardless
// of where a new item is inserted; same-date entries retain their source order.
const sortedNews = [...news].sort((a, b) => b.iso.localeCompare(a.iso));
const newsPreviewCount = 3;
const recentNews = sortedNews.slice(0, newsPreviewCount);
const olderNews = sortedNews.slice(newsPreviewCount);
---
<Layout>
  <section class="hero" aria-labelledby="intro-heading">
    <div class="hero-copy">
      <p class="eyebrow">Machine learning researcher</p>
      <h1 id="intro-heading">Yucheng Xing<span class="chinese-name" lang="zh">邢宇程</span></h1>
      <p class="role">{profile.role}</p>
      <p class="intro">I study <strong>generative models</strong> and <strong>neural dynamics</strong>, with a focus on making learning and inference more efficient and adaptive.</p>
      <p class="bio">I received my Ph.D. in Electrical Engineering from Stony Brook University in 2026, advised by <a href="https://www.ece.stonybrook.edu/~xwang/">Prof. Xin Wang</a>. My work spans diffusion models, neural differential equations, and adaptive neural architectures.</p>
      <div class="social-links" aria-label="Professional profiles"><a href={profile.scholar}>Google Scholar <span aria-hidden="true">↗</span></a><a href={profile.github}>GitHub <span aria-hidden="true">↗</span></a><a href={profile.linkedin}>LinkedIn <span aria-hidden="true">↗</span></a></div>
      <p class="contact-email"><span>Email</span> <span class="email-display">{profile.emailDisplay}</span></p>
    </div>
    <figure class="portrait"><img src={path('images/portrait.jpg')} alt="Yucheng Xing outdoors" width="244" height="300" fetchpriority="high" /><figcaption>Stony Brook, New York</figcaption></figure>
  </section>
  <div class="focus-strip" aria-label="Research areas">
    <div class="focus-item"><a href={path('research/#generative')}>Efficient Generative AI</a><span>Diffusion · Conditional generation</span></div>
    <div class="focus-item"><a href={path('research/#continuous')}>Continuous-Time Modeling</a><span>Neural ODEs / SDEs · Graph dynamics</span></div>
    <div class="focus-item"><a href={path('research/#adaptive')}>Adaptive Architectures</a><span>Input-adaptive computation</span></div>
  </div>
  <div class="home-content">
    <section aria-labelledby="selected-heading">
      <div class="section-heading"><h2 id="selected-heading">Selected research</h2><a class="text-link" href={path('publications/')}>All publications</a></div>
      <div class="paper-list">{selected.map(paper=><Paper paper={paper} compact />)}</div>
    </section>
    <aside class="sidebar">
      <section class="news-section" aria-labelledby="news-heading">
        <h2 id="news-heading">News</h2>
        <ol class="news-list recent-news">
          {recentNews.map(item => <li><time datetime={item.iso}>{item.date}</time><p>{item.href ? <a href={item.href}>{item.text}</a> : item.text}</p></li>)}
        </ol>
        {olderNews.length > 0 && <details class="news-archive">
          <summary><span class="news-show-more">Show more ({olderNews.length})</span><span class="news-show-less">Show less</span></summary>
          <ol class="news-list older-news" start={newsPreviewCount + 1}>
            {olderNews.map(item => <li><time datetime={item.iso}>{item.date}</time><p>{item.href ? <a href={item.href}>{item.text}</a> : item.text}</p></li>)}
          </ol>
        </details>}
      </section>
      <section aria-labelledby="education-heading"><h2 id="education-heading">Education</h2><div class="education-item"><span class="degree">Ph.D. · Electrical Engineering</span><p>Stony Brook University<br />2026</p></div><div class="education-item"><span class="degree">M.S. · Electrical Engineering</span><p>Stony Brook University<br />2021</p></div><div class="education-item"><span class="degree">B.S. · Computer Science</span><p>Shanghai Jiao Tong University<br />IEEE Honor Class · 2017</p></div></section>
    </aside>
  </div>
  <section class="service" aria-labelledby="service-heading"><h2 id="service-heading">Selected Professional Service</h2><p>I serve as a reviewer for conferences and journals including CVPR, ICCV, NeurIPS, ICML, ICLR, AAAI, and IEEE TPAMI.</p><a class="text-link" href={path('service/')}>View professional service <span aria-hidden="true">↗</span></a></section>
</Layout>

<style>
  .news-section { margin-bottom: 42px; }
  .news-section .news-list { margin-bottom: 0; }
  .news-section .news-list li:last-child { margin-bottom: 0; }
  .news-archive { margin-top: 18px; }
  .news-archive summary { color: var(--accent); cursor: pointer; font-size: 13px; font-weight: 550; padding: 5px 0; }
  .news-archive summary::marker { font-size: 10px; }
  .news-show-less { display: none; }
  .news-archive[open] .news-show-more { display: none; }
  .news-archive[open] .news-show-less { display: inline; }
  .news-archive .older-news { margin-top: 18px; }
  @media (max-width: 720px) { .news-section { margin-bottom: 0; } }
</style>
