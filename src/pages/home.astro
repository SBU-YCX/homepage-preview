---
import Layout from '../layouts/Layout.astro';
import Paper from '../components/Paper.astro';
import { profile, news } from '../data/profile';
import { selected } from '../data/publications';
import { path } from '../lib/paths';

// Keep the complete source list. ISO dates determine display order, regardless
// of where a new item is inserted; same-date entries retain their source order.
const sortedNews = [...news].sort((a, b) => b.iso.localeCompare(a.iso));
const newsPreviewCount = 3;
const recentNews = sortedNews.slice(0, newsPreviewCount);
const olderNews = sortedNews.slice(newsPreviewCount);
// 从完整 News 列表生成年份归档，年份从新到旧排列。
const newsYears = [
  ...new Set(sortedNews.map((item) => item.iso.slice(0, 4))),
].sort((a, b) => b.localeCompare(a));

const newsByYear = newsYears.map((year) => ({
  year,
  items: sortedNews.filter((item) => item.iso.startsWith(`${year}-`)),
}));
---

<Layout>
  <section
    class="hero"
    aria-labelledby="intro-heading"
  >
    <div class="hero-copy">
      <p class="eyebrow">Machine learning researcher</p>
      <h1 id="intro-heading">
        Yucheng Xing
        <span
          class="chinese-name"
          lang="zh"
        >
          邢宇程
        </span>
      </h1>
      <p class="role">{profile.role}</p>
      <p class="intro">
        My research focuses on efficient and adaptive machine learning, with applications in computer vision and graph-based spatiotemporal forecasting.
      </p>
      <p class="bio">
        I received my Ph.D. in Electrical Engineering from Stony Brook University in 2026, advised 
        by{' '}
        <a
          href="https://www.ece.stonybrook.edu/~xwang/"
          target="_blank"
          rel="noopener noreferrer"
        >
          Prof. Xin Wang
        </a>
        .
      </p>
            <!--
        Icons: Font Awesome Free 7.3.1 by Fonticons, Inc.
        https://fontawesome.com — https://fontawesome.com/license/free
        SVG icons licensed under CC BY 4.0.
      -->
      <div
        class="social-links"
        aria-label="Professional profiles"
      >
        <a
          href={profile.scholar}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Google Scholar"
          title="Google Scholar"
        >
          <svg
            viewBox="0 0 512 512"
            aria-hidden="true"
            focusable="false"
          >
            <path
              d="M390.9 298.5s0 .1 .1 .1c9.2 19.4 14.4 41.1 14.4 64-.1 82.5-66.9 149.4-149.4 149.4
                 S106.7 445.1 106.7 362.7c0-22.9 5.2-44.6 14.4-64 1.7-3.6 3.6-7.2 5.6-10.7
                 4.4-7.6 9.4-14.7 15-21.3 27.4-32.6 68.5-53.3 114.4-53.3
                 33.6 0 64.6 11.1 89.6 29.9 9.1 6.9 17.4 14.7 24.8 23.5
                 5.6 6.6 10.6 13.8 15 21.3 2 3.4 3.8 7 5.5 10.5l-.1-.1z
                 m26.4-18.8c-30.1-58.4-91-98.4-161.3-98.4s-131.2 40-161.3 98.4
                 l-94.7-77 256-202.7 256 202.7-94.7 77.1 0-.1z"
            />
          </svg>
        </a>

        <a
          href={profile.github}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub"
          title="GitHub"
        >
          <svg
            viewBox="0 0 512 512"
            aria-hidden="true"
            focusable="false"
          >
            <path
              d="M216.5 362.5c-66-8-112.5-55.5-112.5-117 0-25 9-52 24-70
                 -6.5-16.5-5.5-51.5 2-66 20-2.5 47 8 63 22.5
                 19-6 39-9 63.5-9s44.5 3 62.5 8.5c15.5-14 43-24.5 63-22
                 7 13.5 8 48.5 1.5 65.5 16 19 24.5 44.5 24.5 70.5
                 0 61.5-46.5 108-113.5 116.5 17 11 28.5 35 28.5 62.5l0 52
                 C323 491.5 335.5 500 350.5 494 441 459.5 512 369 512 257
                 512 115.5 397 0 255.5 0S0 115.5 0 257c0 111 70.5 203 165.5 237.5
                 13.5 5 26.5-4 26.5-17.5l0-40c-7 3-16 5-24 5
                 -33 0-52.5-18-66.5-51.5-5.5-13.5-11.5-21.5-23-23
                 -6-.5-8-3-8-6 0-6 10-10.5 20-10.5 14.5 0 27 9 40 27.5
                 10 14.5 20.5 21 33 21s20.5-4.5 32-16c8.5-8.5 15-16 21-21z"
            />
          </svg>
        </a>

        <a
          href={profile.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
          title="LinkedIn"
        >
          <svg
            viewBox="0 0 448 512"
            aria-hidden="true"
            focusable="false"
          >
            <path
              d="M100.3 448l-92.9 0 0-299.1 92.9 0 0 299.1z
                 M53.8 108.1C24.1 108.1 0 83.5 0 53.8
                 0 39.5 5.7 25.9 15.8 15.8s23.8-15.8 38-15.8
                 27.9 5.7 38 15.8 15.8 23.8 15.8 38
                 c0 29.7-24.1 54.3-53.8 54.3z
                 M447.9 448l-92.7 0 0-145.6c0-34.7-.7-79.2-48.3-79.2
                 -48.3 0-55.7 37.7-55.7 76.7l0 148.1-92.8 0 0-299.1 89.1 0 0 40.8 1.3 0
                 c12.4-23.5 42.7-48.3 87.9-48.3 94 0 111.3 61.9 111.3 142.3
                 l0 164.3-.1 0z"
            />
          </svg>
        </a>

                <a
          href={profile.leetcode}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LeetCode"
          title="LeetCode"
        >
          <svg
            viewBox="0 0 24 24"
            aria-hidden="true"
            focusable="false"
          >
            <path
              d="M13.483 0a1.374 1.374 0 0 0-.961.438L7.116 6.226
                 l-3.854 4.126a5.266 5.266 0 0 0-1.209 2.104
                 5.35 5.35 0 0 0-.125.513 5.527 5.527 0 0 0 .062 2.362
                 5.83 5.83 0 0 0 .349 1.017 5.938 5.938 0 0 0 1.271 1.818
                 l4.277 4.193.039.038c2.248 2.165 5.852 2.133 8.063-.074
                 l2.396-2.392c.54-.54.54-1.414.003-1.955
                 a1.378 1.378 0 0 0-1.951-.003l-2.396 2.392
                 a3.021 3.021 0 0 1-4.205.038l-.02-.019-4.276-4.193
                 c-.652-.64-.972-1.469-.948-2.263
                 a2.68 2.68 0 0 1 .066-.523
                 2.545 2.545 0 0 1 .619-1.164L9.13 8.114
                 c1.058-1.134 3.204-1.27 4.43-.278l3.501 2.831
                 c.593.48 1.461.387 1.94-.207
                 a1.384 1.384 0 0 0-.207-1.943l-3.5-2.831
                 c-.8-.647-1.766-1.045-2.774-1.202l2.015-2.158
                 A1.384 1.384 0 0 0 13.483 0z
                 m-2.866 12.815a1.38 1.38 0 0 0-1.38 1.382
                 1.38 1.38 0 0 0 1.38 1.382H20.79
                 a1.38 1.38 0 0 0 1.38-1.382
                 1.38 1.38 0 0 0-1.38-1.382z"
            />
          </svg>
        </a>
      </div>
      <p class="contact-email">
        <span>Email</span> <span class="email-display">{profile.emailDisplay}</span>
      </p>
    </div>
    <figure class="portrait">
      <img
        src={path('images/portrait.jpg')}
        alt="Yucheng Xing outdoors"
        width="244"
        height="300"
        fetchpriority="high"
      />
      <figcaption>Stony Brook, New York</figcaption>
    </figure>
  </section>
  <div
    class="focus-strip"
    aria-label="Research areas"
  >
    <div class="focus-item">
      <a href={path('research/#generative')}>Generative AI</a>
      <span>Diffusion Models</span>
    </div>
    <div class="focus-item">
      <a href={path('research/#continuous')}>Continuous-Time Modeling</a>
      <span>Neural ODEs · Neural SDEs</span>
    </div>
    <div class="focus-item">
      <a href={path('research/#adaptive')}>Adaptive Neural Architectures</a>
      <span>Input-Adaptive Computation</span>
    </div>
  </div>
  <div class="home-content">
    <!-- 左栏：Research 和 Service 连续排列。 -->
    <div class="home-main">
      <section aria-labelledby="selected-heading">
        <div class="section-heading">
          <h2 id="selected-heading">Selected research</h2>
          <a
            class="text-link"
            href={path('publications/')}
          >
            All publications
          </a>
        </div>

        <div class="paper-list">
          {selected.map((paper) => (
            <Paper
              paper={paper}
              compact
            />
          ))}
        </div>
      </section>

      <section
        class="project-participation"
        aria-labelledby="projects-heading"
      >
        <div class="section-heading">
          <h2 id="projects-heading">Research Project Participation</h2>
        </div>

        <ul class="project-list">
          <li>
            <h3>
              NSF Convergence Accelerator–Track D:
              AI-Enabled Provably Resilient Networked Microgrids
            </h3>
            <p>
              Funding agency: U.S. National Science Foundation (NSF)
            </p>
          </li>

          <li>
            <h3>
              Solar PLUS: Solar Integration through Physics-Aware
              Learning Based Ultra-Scalable Modeling and Analytics
            </h3>
            <p>
              Funding agency: U.S. Department of Energy (DOE)
            </p>
          </li>
        </ul>
      </section>

      <section
        class="service"
        aria-labelledby="service-heading"
      >
        <div class="section-heading">
          <h2 id="service-heading">Selected Professional Service</h2>
          <a
            class="text-link"
            href={path('service/')}
          >
            All service
          </a>
        </div>

        <p>
          I serve as a reviewer for conferences and journals including
          CVPR, ICCV, ECCV, NeurIPS, ICML, ICLR, AAAI, and IEEE TPAMI.
        </p>
      </section>
    </div>
    <aside class="sidebar">
      <section
        class="news-section"
        aria-labelledby="news-heading"
      >
        <h2 id="news-heading">News</h2>
        <ol class="news-list recent-news">
          {recentNews.map((item) => (
            <li>
              <time datetime={item.iso}>{item.date}</time>
              <p>
                {item.href ? (
                  <a
                    href={item.href}
                    target={/^https?:\/\//.test(item.href) ? '_blank' : undefined}
                    rel={/^https?:\/\//.test(item.href) ? 'noopener noreferrer' : undefined}
                  >
                    {item.text}
                  </a>
                ) : (
                  item.text
                )}
              </p>
            </li>
          ))}
        </ol>
        {olderNews.length > 0 && (
          <details class="news-archive">
            <summary>
              <span class="news-show-more">Show more</span>
              <span class="news-show-less">Show less</span>
            </summary>

            <div class="news-years">
              {newsByYear.map((group) => (
                <details
                  class="news-year"
                  name="home-news-year"
                >
                  <summary>
                    {group.year}
                    <span class="news-year-count">
                      {' '}({group.items.length})
                    </span>
                  </summary>

                  <ol class="news-list">
                    {group.items.map((item) => (
                      <li>
                        <time datetime={item.iso}>{item.date}</time>
                        <p>
                          {item.href ? (
                            <a
                              href={item.href}
                              target={/^https?:\/\//.test(item.href) ? '_blank' : undefined}
                              rel={/^https?:\/\//.test(item.href) ? 'noopener noreferrer' : undefined}
                            >
                              {item.text}
                            </a>
                          ) : (
                            item.text
                          )}
                        </p>
                      </li>
                    ))}
                  </ol>
                </details>
              ))}
            </div>
          </details>
        )}
      </section>
      <section aria-labelledby="education-heading">
        <h2 id="education-heading">Education</h2>
        <div class="education-item">
          <span class="degree">Ph.D. · Electrical Engineering</span>
          <p>
            Stony Brook University
            <br />
            2026
          </p>
        </div>
        <div class="education-item">
          <span class="degree">M.S. · Electrical Engineering</span>
          <p>
            Stony Brook University
            <br />
            2021
          </p>
        </div>
        <div class="education-item">
          <span class="degree">B.S. · Computer Science</span>
          <p>
            Shanghai Jiao Tong University
            <br />
            IEEE Honor Class · 2017
          </p>
        </div>
      </section>
    </aside>
  </div>
</Layout>

<style>
  /* ===== 简介 ===== */

  .hero .intro,
  .hero .bio {
    max-width: 680px;
    margin: 0 0 14px;
    font-size: 17px;
    font-weight: 400;
    line-height: 1.8;
    color: var(--ink);
  }

  /* ===== 社交链接：统一按钮与图标尺寸 ===== */

  .social-links a {
    box-sizing: border-box;
    width: 44px;
    height: 44px;
    flex: 0 0 44px;
    padding: 0;
    gap: 0;
    justify-content: center;
    align-items: center;
  }

  .social-links svg {
    display: block;
    width: 22px;
    height: 22px;
    fill: currentColor;
  }

  .social-links a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  /* ===== 首页两栏布局 ===== */

  .home-content {
    align-items: start;
  }

  .home-main {
    min-width: 0;
  }

  /* ===== 左栏三个大板块：统一标题 ===== */

  .home-main > section > .section-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px 20px;
    margin-bottom: 22px;
  }

  .home-main > section > .section-heading > h2 {
    margin: 0;
    font-family: var(--serif);
    font-size: 30px;
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.6px;
    color: var(--ink);
  }

  /* 大板块之间：较深的 2px 分隔线。 */
  .home-main > .project-participation,
  .home-main > .service {
    margin-top: 32px;
    padding: 32px 0 0;
    border-top: 2px solid var(--line-strong, #98abb1);
  }

  /*
   * 论文之间沿用全局的 1px 浅色细线。
   * 最后一篇去掉底线和底部留白，
   * 由 Projects 上方的板块分隔线接替。
   */
  .home-main .paper-list :global(.paper:last-child) {
    border-bottom: 0;
    padding-bottom: 0;
  }

  /* ===== 项目参与经历 ===== */

  .project-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* 同一板块内的项目之间：1px 浅色细线。 */
  .project-list li + li {
    margin-top: 18px;
    padding-top: 18px;
    border-top: 1px solid var(--line);
  }

  .project-list h3 {
    margin: 0 0 8px;
    font-family: var(--sans);
    font-size: 17px;
    font-weight: 600;
    line-height: 1.6;
    color: var(--ink);
  }

  .project-list p {
    margin: 0;
    font-size: 14px;
    line-height: 1.7;
    color: var(--muted);
  }

  /* ===== News：最新消息 ===== */

  .news-section {
    margin-bottom: 42px;
  }

  .news-section .news-list {
    margin-bottom: 0;
  }

  .news-section .news-list li:last-child {
    margin-bottom: 0;
  }

  /* ===== News：展开与收起 ===== */

  .news-archive {
    margin-top: 18px;
  }

  .news-archive summary {
    padding: 5px 0;
    font-size: 13px;
    font-weight: 550;
    color: var(--accent);
    cursor: pointer;
  }

  .news-archive summary::marker {
    font-size: 10px;
  }

  .news-show-less {
    display: none;
  }

  .news-archive[open] .news-show-more {
    display: none;
  }

  .news-archive[open] .news-show-less {
    display: inline;
  }

  /* ===== News：按年份归档，内部滚动 ===== */

  .news-years {
    max-height: 360px;
    overflow-y: auto;
    margin-top: 12px;
    padding-right: 8px;
  }

  .news-year {
    padding: 6px 0;
  }

  .news-year + .news-year {
    border-top: 1px solid var(--line);
  }

  .news-year > summary {
    font-weight: 600;
  }

  .news-year-count {
    font-weight: 400;
    color: var(--muted);
  }

  .news-year .news-list {
    margin: 12px 0 18px;
  }

  /* ===== 桌面端 ===== */

  @media (min-width: 721px) {
    /* 三个研究方向在各自栏位内居中。 */
    .focus-strip .focus-item,
    .focus-strip .focus-item:first-child {
      padding: 0 24px;
      text-align: center;
    }
  }

  /* ===== 手机端 ===== */

  @media (max-width: 720px) {
    .hero .intro,
    .hero .bio {
      font-size: 16px;
      line-height: 1.75;
    }

    .home-main > section > .section-heading > h2 {
      font-size: 28px;
    }

    .home-main > .project-participation,
    .home-main > .service {
      margin-top: 28px;
      padding-top: 28px;
    }

    .news-section {
      margin-bottom: 0;
    }
  }
</style>