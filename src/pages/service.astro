---
import Layout from '../layouts/Layout.astro';
import { conferenceService, journalService, secondaryService, teaching } from '../data/service';
const groups = [
  { id: 'conferences', title: 'Conferences', role: 'Reviewer', items: conferenceService },
  { id: 'journals', title: 'Journals', role: 'Reviewer', items: journalService },
  {
    id: 'secondary-review',
    title: 'Secondary Review',
    role: 'Secondary reviewer',
    items: secondaryService,
  },
  {
    id: 'teaching',
    title: 'Teaching',
    role: 'Teaching assistant · Stony Brook University',
    items: teaching,
  },
];

// 从年份文字中提取最大的年份。
// 例如：2024–2026 → 2026，2025 → 2025。
function latestYear(years: string): number {
  const matches = years.match(/\d{4}/g);

  return matches ? Math.max(...matches.map(Number)) : 0;
}

// 每个大类分别排序，不改变原始数据数组。
const sortedGroups = groups.map((group) => ({
  ...group,
  items: [...group.items].sort(
    (a, b) => latestYear(b.years) - latestYear(a.years),
  ),
}));
---

<Layout
  title="Professional Service — Yucheng Xing"
  active="service"
>
  <header class="page-intro">
    <p class="eyebrow">Academic community</p>
    <h1>Professional Service</h1>
    <p>Peer review and teaching in machine learning and computer vision.</p>
  </header>
  <div class="service-page">
    {sortedGroups.map((group, index) => (
      <section
        class="service-group"
        aria-labelledby={group.id}
      >
        <div class="service-group-heading">
          <span class="eyebrow">{String(index + 1).padStart(2, '0')}</span>
          <h2 id={group.id}>{group.title}</h2>
          <p class="service-group-role">{group.role}</p>
        </div>
        <ul class="service-list">
          {group.items.map((item) => (
            <li>
              <div>
                <h3>{item.short}</h3>
                {item.name !== item.short && <p>{item.name}</p>}
              </div>
              {item.years && <span class="service-role">{item.years}</span>}
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Layout>

<style>
  .service-group-role {
    color: var(--muted);
    font-size: 13px;
    line-height: 1.7;
    margin: 13px 0 0;
  }
  @media (max-width: 720px) {
    .service-group-heading {
      flex-wrap: wrap;
    }
    .service-group-role {
      flex-basis: 100%;
      margin-top: -8px;
    }
  }
</style>
