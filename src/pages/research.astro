---
import Layout from '../layouts/Layout.astro';
import RelatedWork from '../components/RelatedWork.astro';
import { path } from '../lib/paths';

// 顺序与首页一致：Generative → Continuous-Time → Adaptive。
// 保留下面三个 section 的 id，首页的方向链接会跳到对应位置。
// 每个方向下的 RelatedWork 列表控制代表论文；id 对应 publications.ts。
---

<Layout
  title="Research Interests — Yucheng Xing"
  active="research"
>
  <header class="page-intro">
    <h1>Research Interests</h1>
    <p>
      My research connects generative modeling, continuous-time dynamics, and adaptive neural
      architectures, with applications in computer vision and graph-based spatiotemporal
      forecasting.
    </p>
  </header>

  <div class="research-list">
    <!-- 01：生成建模。应用细节由下面的代表论文呈现。 -->
    <section
      class="research-section"
      id="generative"
      aria-labelledby="generative-heading"
    >
      <span
        class="research-number"
        aria-hidden="true"
      >
        01
      </span>

      <div class="research-copy">
        <h2 id="generative-heading">Generative AI</h2>
        <p>
          I study how generative models can use structural and conditional information to guide the
          generation process. My goal is to make generation more controllable and computationally
          efficient while preserving output quality and consistency.
        </p>

        <!-- 暂用统一的问题侧栏；以后选好概念图可替换整个 aside。 -->
        <aside
          class="research-note"
          aria-labelledby="generative-questions"
        >
          <span
            class="eyebrow"
            id="generative-questions"
          >
            Key questions
          </span>
          <p>How can structure and conditioning guide generation?</p>
          <p>How can generation quality be maintained with less computation?</p>
        </aside>

        <RelatedWork
          works={[
            {
              id: 'ac-diff',
              name: 'AC-Diff',
              venue: 'arXiv · 2024',
            },
            {
              id: 'spectral-diffusion',
              name: 'SpectralDiff',
              venue: 'arXiv · 2026',
            },
            {
              id: 'ntree-diffusion',
              name: 'NT-Diffusion',
              venue: 'arXiv · 2026',
            },
          ]}
        />
      </div>

      <figure class="research-figure">
        <img
          src={path('images/nt-diffusion.PNG')}
          alt="generative modeling - nt-diffusion"
          width="320"
          height="220"
          loading="lazy"
        />
      </figure>

    </section>

    <!-- 02：连续时间建模。这里选择以连续动力学为核心的工作。 -->
    <section
      class="research-section"
      id="continuous"
      aria-labelledby="continuous-heading"
    >
      <span
        class="research-number"
        aria-hidden="true"
      >
        02
      </span>

      <div class="research-copy">
        <h2 id="continuous-heading">Continuous-Time Modeling</h2>
        <p>
          I study how to learn the evolution of structured systems from sparse, irregular, and noisy
          observations. Using neural differential equations, I aim to capture temporal dynamics,
          interactions among entities, and uncertainty within continuous-time models.
        </p>

          <aside
          class="research-note"
          aria-labelledby="continuous-questions"
        >
          <span
            class="eyebrow"
            id="continuous-questions"
          >
            Key questions
          </span>
          <p>How can models learn dynamics between irregular observations?</p>
          <p>How can interactions and uncertainty be represented in continuous time?</p>
        </aside>

        <RelatedWork
          works={[
            {
              id: 'hdg-ode',
              name: 'HDG-ODE',
              venue: 'ICCV · 2023',
            },
            {
              id: 'aggdn',
              name: 'AGGDN',
              venue: 'ICONIP · 2023',
            },
          ]}
        />
      </div>

      <figure class="research-figure">
        <img
          src={path('images/aggdn.png')}
          alt="continuous-time - aggdn"
          width="320"
          height="220"
          loading="lazy"
        />
      </figure>

    </section>

    <!-- 03：自适应网络结构。代表论文数量不需要与其他方向相同。 -->
    <section
      class="research-section"
      id="adaptive"
      aria-labelledby="adaptive-heading"
    >
      <span
        class="research-number"
        aria-hidden="true"
      >
        03
      </span>

      <div class="research-copy">
        <h2 id="adaptive-heading">Adaptive Neural Architectures</h2>
        <p>
          I study how neural networks can adapt their parameters and computational depth to
          individual inputs. My goal is to make computation more flexible, balancing predictive
          performance, parameter storage, and inference cost.
        </p>

          <aside
          class="research-note"
          aria-labelledby="adaptive-questions"
        >
          <span
            class="eyebrow"
            id="adaptive-questions"
          >
            Key questions
          </span>
          <p>How much computation does each input need?</p>
          <p>How can compact parameterizations support flexible computation?</p>
        </aside>

        <RelatedWork
          works={[
            {
              id: 'puppet-cnn',
              name: 'Puppet-CNN',
              venue: 'ECCV · 2026',
            },
            {
              id: 'ac-diff',
              name: 'AC-Diff',
              venue: 'arXiv · 2024',
            },
          ]}
        />
      </div>

      <figure class="research-figure">
        <img
          src={path('images/puppet-cnn.png')}
          alt="adaptive computation - puppet-cnn"
          width="320"
          height="220"
          loading="lazy"
        />
      </figure>
      
    </section>
  </div>
</Layout>

<style>
  .research-copy {
    min-width: 0;
  }

  /* 长论文名和期刊名在窄屏上正常换行。 */
  .research-copy :global(.related li) {
    max-width: 100%;
  }

  .research-copy :global(.related a) {
    grid-template-columns: minmax(0, 1fr) auto;
  }

  .research-copy :global(.related-name),
  .research-copy :global(.related-venue) {
    overflow-wrap: anywhere;
  }

    /* 问题放在简介下面，以较轻的斜体呈现。 */
  .research-note {
    margin: 18px 0 0;
    padding: 0;
    background: none;
    border: 0;
  }

  .research-note .eyebrow {
    display: block;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0;
    text-transform: none;
    margin-bottom: 8px;
  }

  .research-note p {
    font-family: var(--sans);
    font-size: 15px;
    font-style: italic;
    line-height: 1.75;
    color: var(--muted);
    margin: 0 0 7px;
  }

  .research-note p:last-child {
    margin-bottom: 0;
  }

  /* 没有配图时，让文字使用右侧空出的空间。 */
  .research-section:not(:has(> .research-figure)) .research-copy {
    grid-column: 2 / -1;
    max-width: 760px;
  }

  .research-section > .research-figure {
    align-self: start;
  }
</style>
