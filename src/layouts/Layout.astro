---
import '../styles/global.css';
import { path } from '../lib/paths';
import { profile } from '../data/profile';
import { appearance } from '../data/appearance';
const {
  title = 'Yucheng Xing — Machine Learning Researcher',
  description = 'Yucheng Xing is a researcher working on efficient generative AI, continuous-time neural modeling, and adaptive neural architectures.',
  active = 'home',
  welcome = false,
} = Astro.props;
const nav = [
  { label: 'Home', url: path('home/'), key: 'home' },
  { label: 'Research', url: path('research/'), key: 'research' },
  { label: 'Publications', url: path('publications/'), key: 'publications' },
  { label: 'Service', url: path('service/'), key: 'service' },
  { label: 'CV', url: path(profile.cv), key: 'cv' },
];
const photoConfig = {
  ...appearance,
  home: path('home/'),
  welcome: path(),
  photos: appearance.photos.map((photo) => ({
    ...photo,
    url: path(`images/photography/${photo.file}`),
  })),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <meta
      name="description"
      content={description}
    />
    <meta
      name="theme-color"
      content="#19384b"
    />
    <meta
      property="og:title"
      content={title}
    />
    <meta
      property="og:description"
      content={description}
    />
    <meta
      property="og:type"
      content="website"
    />
    <title>{title}</title>
    <link
      rel="icon"
      type="image/svg+xml"
      href={path('favicon.svg')}
    />
    <style
      is:inline
      set:html={`@font-face{font-family:"YX Chinese Serif";src:url("${path('fonts/name-serif.ttf')}") format("truetype");font-style:normal;font-weight:400;font-display:swap;unicode-range:U+90A2,U+5B87,U+7A0B;}`}
    />
  </head>
  <body
    class:list={{ 'welcome-page': welcome }}
    data-page={welcome ? 'welcome' : active}
    style={`--photo-opacity:${appearance.backgroundOpacity}`}
  >
    {!welcome && (
      <div
        class="site-backdrop"
        aria-hidden="true"
      >
        <img
          id="site-background-photo"
          src={photoConfig.photos[0].url}
          alt=""
          decoding="async"
        />
      </div>
    )}
    {welcome ? (
      <slot />
    ) : (
      <>
        <a
          class="skip-link"
          href="#main"
        >
          Skip to content
        </a>
        <header class="site-header">
          <div class="wrap header-inner">
            <a
              class="wordmark"
              href={path('home/')}
              aria-label="Yucheng Xing home"
            >
              <span
                class="monogram"
                aria-hidden="true"
              >
                YX
              </span>
              Yucheng Xing
            </a>
            <nav
              class="primary-nav"
              aria-label="Main navigation"
            >
              {nav.map((item) => (
                <a
                  href={item.url}
                  target={item.key === 'cv' ? '_blank' : undefined}
                  rel={item.key === 'cv' ? 'noopener noreferrer' : undefined}
                  aria-current={active === item.key ? 'page' : undefined}
                >
                  {item.label}
                </a>
              ))}
            </nav>
          </div>
        </header>
        <main
          id="main"
          class="wrap"
        >
          <slot />
        </main>
        <footer class="site-footer">
          <div class="wrap footer-inner">
            <span>© 2026 Yucheng Xing</span>
            <div class="footer-links">
              <span class="email-display">{profile.emailDisplay}</span>
              <a href={path('?welcome=1')}>Photography</a>
              <a
                href={profile.github}
                target="_blank"
                rel="noopener noreferrer"
              >
                GitHub
              </a>
            </div>
          </div>
        </footer>
      </>
    )}
    <script
      id="site-photo-config"
      type="application/json"
      is:inline
      set:html={JSON.stringify(photoConfig).replace(/</g, '\\u003c')}
    />
    <script
      is:inline
      src={path('scripts/site.js')}
      defer
    ></script>
  </body>
</html>
